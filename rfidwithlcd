#include <SPI.h>
#include <MFRC522.h>
#include <Wire.h>                  // Added for I2C communication
#include <LiquidCrystal_I2C.h>     // Added for the LCD Display

#define RST_PIN         9          
#define SS_PIN          10         
#define LED_PIN         2          // LED connected to Digital Pin 2

MFRC522 mfrc522(SS_PIN, RST_PIN);  

// Initialize the LCD. 0x27 is the common I2C address. 16, 2 means a 16x2 character display.
// If your screen stays blank or doesn't work, try 0x3F instead of 0x27.
LiquidCrystal_I2C lcd(0x27, 16, 2); 

// Define your authorized UID codes (Length is 4 bytes for standard MIFARE tags)
byte validTag1[] = {0x8A, 0xD0, 0x9B, 0x1A};
byte validTag2[] = {0x7A, 0x5B, 0x92, 0x1A};

void setup() {
  Serial.begin(9600);        
  while (!Serial);        
  SPI.begin();            
  mfrc522.PCD_Init();        
  
  pinMode(LED_PIN, OUTPUT);        // Set the LED pin as an output
  digitalWrite(LED_PIN, LOW);      // Make sure the LED starts turned OFF
  
  // LCD Initialization
  lcd.init();                      // Start the LCD library
  lcd.backlight();                 // Turn on the screen backlight
  
  // Show welcome message on LCD
  lcd.clear();
  lcd.setCursor(0, 0);             // Column 0, Row 0
  lcd.print(" SYSTEM SECURED ");
  lcd.setCursor(0, 1);             // Column 0, Row 1
  lcd.print("Scan your tag...");
  
  Serial.println(F("SYSTEM SECURED: Scan an authorized tag..."));
}

void loop() {
  // Look for new cards
  if ( ! mfrc522.PICC_IsNewCardPresent()) {
    return;
  }

  // Select one of the cards
  if ( ! mfrc522.PICC_ReadCardSerial()) {
    return;
  }

  // 1. Grab and print the scanned Tag Code
  Serial.print("Scanned Tag Code:");
  for (byte i = 0; i < mfrc522.uid.size; i++) {
    Serial.print(" ");
    if(mfrc522.uid.uidByte[i] < 0x10) Serial.print("0");
    Serial.print(mfrc522.uid.uidByte[i], HEX);
  }
  Serial.println();
  
  // 2. Check if the scanned card matches either of the allowed tags
  bool accessGranted = false;
  
  if (checkMatch(mfrc522.uid.uidByte, validTag1, mfrc522.uid.size) || 
      checkMatch(mfrc522.uid.uidByte, validTag2, mfrc522.uid.size)) {
    accessGranted = true;
  }

  // 3. Take action based on authorization
  if (accessGranted) {
    Serial.println("ACCESS GRANTED! LED ON for 30 seconds...");
    
    // Update LCD for successful access
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("ACCESS GRANTED!");
    lcd.setCursor(0, 1);
    lcd.print("Welcome home!");
    
    digitalWrite(LED_PIN, HIGH);     // Turn the LED on
    delay(30000);                    // Stay on for 30 seconds
    digitalWrite(LED_PIN, LOW);      // Turn the LED off
    Serial.println("LED OFF. System locked.");
    
  } else {
    Serial.println("ACCESS DENIED! Invalid Tag.");
    
    // Update LCD for failed access
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("ACCESS DENIED!");
    lcd.setCursor(0, 1);
    lcd.print("Invalid Tag!");
    
    // Blink the LED quickly once to signal an error
    digitalWrite(LED_PIN, HIGH);     
    delay(200);
    digitalWrite(LED_PIN, LOW);
    
    delay(2000); // Leave the "Access Denied" text on the screen for 2 seconds
  }
  
  // Reset LCD back to the scanning message for the next person
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print(" SYSTEM SECURED ");
  lcd.setCursor(0, 1);
  lcd.print("Scan your tag...");
  
  // Halt PICC to reset the reader stream
  mfrc522.PICC_HaltA();
}

// Helper function to compare the scanned UID array with our predefined valid arrays
bool checkMatch(byte *scanned, byte *authorized, byte size) {
  for (byte i = 0; i < size; i++) {
    if (scanned[i] != authorized[i]) {
      return false; // If even one byte doesn't match, return false
    }
  }
  return true; // All bytes matched perfectly
}
